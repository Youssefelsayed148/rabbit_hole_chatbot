RETRIEVAL_MODE=keyword
﻿# Copy to .env. Default Docker stack uses fakes and never receives the OpenAI key.
# Development-only credentials; production uses .env.production.example instead.
POSTGRES_PASSWORD=rh
ADMIN_TOKEN=dev-ingest-only
# Public browser key; demo defaults to pk_demo. For another key add &site_key=... .
SITE_KEYS=pk_demo
# Exact origins. api:8000 is needed by the Compose browser runner.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://api:8000,http://localhost:8001,http://127.0.0.1:8001
RATE_LIMIT_PER_MIN=100
DAILY_LLM_CALL_CAP=5000
EMBED_DIMENSIONS=1024
# Only --profile real services receive these values. OPENAI_API_KEY is optional in keyword mode.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
# Blank for reasoning models that reject custom temperature.
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=25
# Optional compatible endpoint; blank uses OpenAI.
OPENAI_BASE_URL=
# Optional: send CHAT to another OpenAI-compatible provider while embeddings stay on OpenAI.
# Example (OpenRouter): CHAT_BASE_URL=https://openrouter.ai/api/v1  CHAT_API_KEY=sk-or-...  OPENAI_CHAT_MODEL=<model id>
# CHAT_BASE_URL requires its own CHAT_API_KEY; never put an OpenRouter key in OPENAI_API_KEY.
# Leave CHAT_BASE_URL and CHAT_API_KEY blank to keep using OpenAI for chat.
# CHAT_JSON_MODE=false if the model rejects response_format. Output is still strictly validated as JSON.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_JSON_MODE=true
# Free-only chat example: OPENAI_CHAT_MODEL=google/gemma-4-31b-it:free
# Set CHAT_FREE_ONLY=true, CHAT_JSON_MODE=true and use explicit free chat fallbacks:
# CHAT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
CHAT_FREE_ONLY=false
CHAT_FALLBACK_MODELS=
# Only the real service reads these; the fake development service keeps catalogue disabled.
CATALOGUE_ENABLED=false
CATALOGUE_BASE_URL=https://rabbitholeapi.theosirislabs.com
SOURCE_BASE_URL=https://darkturquoise-dunlin-447124.hostingersite.com
# Compose fixes ENV=development, AUTO_INGEST=true,
# INCLUDE_UNREVIEWED=false and internal DATABASE_URL. No host database is needed.
