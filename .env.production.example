RETRIEVAL_MODE=keyword
# Template only. Supply actual values in the hosting secret store or .env.production.
ENV=production
OPENAI_API_KEY=
ADMIN_TOKEN=
SITE_KEYS=
# Exact origins: scheme + hostname + optional port; no paths, wildcards or trailing slash.
# Confirmed 2026-10-08: the live Rabbit Hole website origin to allow is
# https://darkturquoise-dunlin-447124.hostingersite.com (no trailing slash).
# Comma-separate multiple origins if the site adds another domain later.
ALLOWED_ORIGINS=https://darkturquoise-dunlin-447124.hostingersite.com
# SITE_KEYS is public. Use the same value in the widget's data-site-key.
POSTGRES_PASSWORD=
# Required for a non-Compose deployment. For the optional Compose file this is overridden.
DATABASE_URL=
# This deploy sits behind Dokploy's Traefik, which sets X-Forwarded-For.
TRUST_PROXY=true
OPENAI_CHAT_MODEL=google/gemma-4-31b-it:free
OPENAI_TEMPERATURE=0.2
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1024
OPENAI_TIMEOUT=25
# Optional compatible endpoint; leave empty for the normal OpenAI endpoint.
OPENAI_BASE_URL=
# Free OpenRouter chat; set CHAT_API_KEY to your OpenRouter key.
# Keyword mode requires no OPENAI_API_KEY. Hybrid mode requires it for embeddings.
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=
CHAT_JSON_MODE=true
CHAT_FREE_ONLY=true
CHAT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
INCLUDE_UNREVIEWED=false
CATALOGUE_ENABLED=true
# Enable only for the verified public shop API; website origin uses SOURCE_BASE_URL below.
CATALOGUE_BASE_URL=https://rabbitholeapi.theosirislabs.com
# Optional: sent as a bearer token to the catalogue API above. Leave blank; the
# verified public shop API above does not currently require one.
CATALOGUE_TOKEN=
AUTO_INGEST=true
RATE_LIMIT_PER_MIN=20
DAILY_LLM_CALL_CAP=5000
# Current verified website origin; update when the public shop domain changes.
SOURCE_BASE_URL=https://darkturquoise-dunlin-447124.hostingersite.com
STORE_MESSAGES=true
MESSAGE_RETENTION_DAYS=30
LOG_MESSAGES=false
# Optional retrieval tuning, both have sane defaults (8 and 4) — uncomment to override.
# TOP_K=8
# FINAL_K=4
# Optional paid fallback when the free models are rate-limited (429). Free models stay first; only
# overflow is billed. Needs CHAT_FREE_ONLY=false because free-only rejects paid IDs. Example:
#   CHAT_FREE_ONLY=false
#   CHAT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-4o-mini
# openai/gpt-4o-mini is not a reasoning model, so no reasoning setting is needed. If you use a reasoning
# model instead (e.g. openai/gpt-5-nano), also set CHAT_REASONING_EFFORT=minimal so it does not spend the
# 700-token budget thinking.
CHAT_REASONING_EFFORT=
